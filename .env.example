# Copy to .env (never commit .env) or export these in your shell / run configuration.
DB_URL=jdbc:postgresql://localhost:5432/kitchenpulse
DB_USERNAME=kitchenpulse
DB_PASSWORD=kitchenpulse

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional: creates the first ADMIN on startup if no user with this email exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
